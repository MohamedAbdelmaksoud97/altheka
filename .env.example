# Browser-safe Supabase configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy projects only:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres
INITIAL_SUPER_ADMIN_EMAIL=admin@example.test
# Optional one-time bootstrap secret. Remove it immediately after use.
INITIAL_SUPER_ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=demo.client@altheka.example
DEMO_CLIENT_PASSWORD=
DEMO_ROLE_PASSWORD=
DEMO_SUPER_ADMIN_PASSWORD=

# Use a local mail capture service in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.test
SMTP_FROM_NAME=منصة العمليات القانونية
